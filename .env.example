# Server environment variables & security secrets
JWT_SECRET=
SYSTEM_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBHOOK_SECRET=
DOTFY_API_KEY=
DISCORD_AFFILIATE_WEBHOOK_URL=

# iNEX: Supabase exclusivo.
DATABASE_PROVIDER=supabase
SUPABASE_URL=https://shmrebownxrvruohvxcp.supabase.co
VITE_SUPABASE_URL=https://shmrebownxrvruohvxcp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HiYc2OIqS1hnkOrITcSc7w_SNji5zOr
# Server only: use a secret key or the legacy service_role key from YOUR project.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep the existing stable values when migrating encrypted settings and sessions.
# JWT_SECRET and SYSTEM_ENCRYPTION_KEY must not change during data migration.

# Endpoint-specific secret returned by Dotfy when registering the public HTTPS webhook.
DOTFY_WEBHOOK_SECRET=
# Explicit opt-in for local simulation only; vk_test_ is NOT a sandbox.
ALLOW_PAYMENT_SIMULATION=false

# Optional per-charge public callback; otherwise use a fixed endpoint registered in Dotfy.
DOTFY_WEBHOOK_URL=

# Pixup — credenciais OAuth2 do servidor para cobranças PIX no admin.
PIXUP_CLIENT_ID=
PIXUP_CLIENT_SECRET=

# Padrão inicial dos saques manuais. O roteamento salvo no painel tem prioridade.
ADMIN_WITHDRAWAL_GATEWAY=dotfy
# URL HTTPS pública e exata do webhook Pixup. Configure antes de ativar.
PIXUP_POSTBACK_URL=
# Opcional: IP do proxy diretamente ligado ao Node, se ele acrescenta o IP do cliente ao X-Forwarded-For.
PIXUP_TRUSTED_PROXY_IP=
